cmake_minimum_required(VERSION 3.22.1)
set(prefix "@CMAKE_CURRENT_BINARY_DIR@/test-install")
file(REMOVE_RECURSE "${prefix}")
execute_process(COMMAND "@CMAKE_COMMAND@" --install "@CMAKE_CURRENT_BINARY_DIR@"
    --prefix "${prefix}" --config "${CONFIG}" RESULT_VARIABLE result OUTPUT_QUIET)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "install failed")
endif()
foreach(header topenapi.h topenapi_tcl.h)
    if(NOT EXISTS "${prefix}/@CMAKE_INSTALL_INCLUDEDIR@/topenapi/${header}")
        message(FATAL_ERROR "missing ${header}")
    endif()
endforeach()
set(package "${prefix}/@TOPENAPI_PACKAGE_DIR@")
if(NOT EXISTS "${package}/pkgIndex.tcl")
    message(FATAL_ERROR "missing package index")
endif()
if(@BUILD_SHARED_LIBS@)
    if(NOT EXISTS "${package}/@CMAKE_SHARED_LIBRARY_PREFIX@topenapi@CMAKE_SHARED_LIBRARY_SUFFIX@")
        message(FATAL_ERROR "missing shared library")
    endif()
    execute_process(COMMAND "@CMAKE_COMMAND@" -E env "TCLLIBPATH=${package}"
        "@TCL_TCLSH@" "@CMAKE_CURRENT_SOURCE_DIR@/tests/all.tcl" RESULT_VARIABLE result)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "installed package tests failed")
    endif()
else()
    foreach(lib topenapi topenapi_core)
        if(NOT EXISTS "${prefix}/@CMAKE_INSTALL_LIBDIR@/@CMAKE_STATIC_LIBRARY_PREFIX@${lib}@CMAKE_STATIC_LIBRARY_SUFFIX@")
            message(FATAL_ERROR "missing static library ${lib}")
        endif()
    endforeach()
endif()
